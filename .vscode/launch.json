  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "Build (Debug)",
      "program": "${workspaceFolder}/sacha.house.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Live Dev",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "Live Dev",
      "program": "${workspaceFolder}/dev_watcher.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6969",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Debug and Launch Chrome",
      "configurations": ["Debug", "Launch Chrome"]
    }
  ]
}
