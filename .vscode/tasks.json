{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build (Debug)",
        "type": "process",
        "command": "make",
        "args": ["build", "mode=debug"]
      },
      {
        "label": "Live Dev",
        "type": "process",
        "command": "make",
        "args": ["build-watcher"]
      },
      {
        "label": "Build (Release)",
        "type": "process",
        "command": "make",
        "args": ["build", "mode=release"]
      },
      {
        "label": "Clean",
        "type": "process",
        "command": "make clean"
      }
    ]
}