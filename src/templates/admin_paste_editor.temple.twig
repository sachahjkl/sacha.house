{% embed "_header.temple.twig" with this.base %}
<article class="mx-auto max-w-5xl">
    <p class="mb-4 text-sm">
        <a href="/admin/pastes" class="opacity-60 underline">
            <span class="inline-block rotate-180" aria-hidden="true">➜</span>
            Go back to encrypted pastes
        </a>
    </p>

    {% if this.Form.IsNew %}<h1 class="h1 mb-4">new encrypted paste</h1>{% end %}
    {% if !this.Form.IsNew %}<h1 class="h1 mb-4">edit encrypted paste</h1>{% end %}

    {% if this.Error != "" %}
        <div class="mb-4 border-2 border-red-500 bg-red-100 p-3 text-red-800" role="alert" aria-live="assertive">{{ this.Error }}</div>
    {% end %}
    {% if this.Notice != "" %}
        <div class="mb-4 border-2 border-blue-300 bg-blue-100 p-3 text-blue-800" role="status" aria-live="polite">{{ this.Notice }}</div>
    {% end %}
    {% if this.Form.NeedsRotation %}
        <p class="mb-4 border-2 border-textColor p-3" role="status">
            This paste uses an older key. Saving or rotating will re-encrypt it with the active key.
        </p>
    {% end %}

    {% if this.Form.GistId != "" %}
        <dl class="mb-4 text-sm">
            <dt class="font-bold">Gist ID</dt>
            <dd class="ml-0 wrap-anywhere"><code>{{ this.Form.GistId }}</code></dd>
            <dt class="font-bold">Revision</dt>
            <dd class="ml-0 wrap-anywhere"><code>{{ this.Form.Revision }}</code></dd>
            <dt class="font-bold">Encryption key</dt>
            <dd class="ml-0 wrap-anywhere"><code>{{ this.Form.KeyId }}</code></dd>
        </dl>
    {% end %}

    <form method="POST" action="{{ this.Form.FormAction }}" class="flex flex-col gap-4">
        <input type="hidden" name="csrf_token" value="{{ this.Form.CsrfToken }}"/>
        {% if !this.Form.IsNew %}<input type="hidden" name="revision" value="{{ this.Form.Revision }}"/>{% end %}

        <label class="flex flex-col gap-1" for="paste-title">
            <span>Title</span>
            <input id="paste-title" type="text" name="title" value="{{ this.Form.Title }}" maxlength="200" required autocomplete="off" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400"/>
        </label>

        <label class="flex flex-col gap-1" for="paste-body">
            <span>Paste body</span>
            <textarea id="paste-body" name="body" rows="24" spellcheck="false" class="min-h-[32rem] border-2 border-textColor bg-transparent p-3 font-mono text-sm text-textColor placeholder-neutral-400">{{ this.Form.Body }}</textarea>
        </label>

        <div class="flex flex-wrap gap-3">
            <button type="submit" class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">
                Save encrypted paste
            </button>
        </div>
    </form>

    {% if !this.Form.IsNew && this.Form.Revision != "" %}
        <div class="divider"></div>
        <section aria-labelledby="paste-rotation-heading">
            <h2 id="paste-rotation-heading">Encryption rotation</h2>
            <p>Re-encrypt the current plaintext with the active key without changing its semantic timestamps.</p>
            <form method="POST" action="/admin/pastes/{{ this.Form.GistId }}/rotate">
                <input type="hidden" name="csrf_token" value="{{ this.Form.CsrfToken }}"/>
                <input type="hidden" name="revision" value="{{ this.Form.Revision }}"/>
                <button type="submit" class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">Re-encrypt with active key</button>
            </form>
        </section>

        <div class="divider"></div>
        <section aria-labelledby="paste-delete-heading">
            <h2 id="paste-delete-heading">Delete encrypted paste</h2>
            <p>This deletes the Gist. Provider revision history may remain subject to GitHub's retention policy.</p>
            <form method="POST" action="/admin/pastes/{{ this.Form.GistId }}/delete" class="flex flex-col gap-3">
                <input type="hidden" name="csrf_token" value="{{ this.Form.CsrfToken }}"/>
                <input type="hidden" name="revision" value="{{ this.Form.Revision }}"/>
                <label class="flex max-w-md flex-col gap-1" for="paste-delete-confirmation">
                    <span>Type DELETE to confirm</span>
                    <input id="paste-delete-confirmation" type="text" name="confirmation" required pattern="DELETE" autocomplete="off" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400"/>
                </label>
                <div>
                    <button type="submit" class="h-10 select-none bg-red-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#991b1b_inset,0_0_0_1px_#dc2626_inset,0_0.5px_0_1.5px_#f87171_inset] hover:bg-red-700 active:bg-red-800">Delete encrypted paste</button>
                </div>
            </form>
        </section>
    {% end %}
</article>
{% embed "_footer.temple.twig" with this.base %}
