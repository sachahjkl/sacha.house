{% embed "_header.temple.twig" with this.base %}
<article class="about-page mx-auto max-w-full text-sm sm:text-base print:max-w-full">
	<h1 class="h1">about</h1>
	<section class="mb-8">
		<div class="avatar my-6 flex justify-center">
			<picture class="border-textColor block border-4">
				<img class="me" src="/static/me.jpg" height="400" width="400" alt="Moi" />
			</picture>
		</div>

		<p>
			My name is <b>{{ this.Prenom }}</b>, I'm
			<em>{{ int(this.Age) }} years old</em>
			and I live in <em>{{ this.PlaceOfLiving }}</em>.
		</p>
		<p>I'm a software engineer. I strive to produce simple, high-quality work.</p>

		<p>
			Feel free to <a class="underline" href="mailto:{{ this.Mail }}">send me an email</a> about what you think of
			this site or any other topic that might interest me (work, discussion, project, ...).
		</p>
		<p>You can <b>find my curriculum vitae</b> by clicking <a hx-boost="false" class="underline" href="{{ this.CurriculumVitae }}">here</a>.</p>
	</section>

	<section class="mb-8" id="professional-details">
		<h2 id="professional-details" class="h2">🖥️ Professional Details</h2>
		<div class="flex flex-col gap-4">
			{% for exp in this.LinkedInExperiences %}
				<section class="border-textColor border-s-[16px] py-2 ps-4">
					<div id="title" class="mb-3">
						<h3 class="ms-0 font-bold">
							{% if exp.company_linkedin_profile_url != "" %}
								<a class="font-bold no-underline hover:underline" href="{{ exp.company_linkedin_profile_url }}">
									{{ exp.company }} 🔗
								</a>
							{% else %}
								{{ exp.company }}
							{% end %}
						</h3>
						<h4 class="italic">{{ exp.title }}</h4>
						<small class="text-bgOffColor">
							<time>{{ exp.starts_at }}</time>
							-
							<time>{{ exp.ends_at }}</time>
						</small>
					</div>
					<div></div>
					<p class="!mb-0">{{ exp.description | raw }}</p>
				</section>
			{% end %}
		</div>
	</section>
	<section class="mb-8" id="academic-background">
		<h2 id="academic-background" class="h2">🏫 Academic Background</h2>
		<div class="flex flex-col gap-4">
			{% for edu in this.LinkedInEducation %}
				<section class="border-textColor border-s-[16px] py-2 ps-4">
					<div id="title" class="mb-3">
						<h3 class="ms-0 font-bold">
							{% if edu.school_linkedin_profile_url != "" %}
								<a class="font-bold no-underline hover:underline" href="{{ edu.school_linkedin_profile_url }}">
									{{ edu.school }} 🔗
								</a>
							{% else %}
								{{ edu.school }}
							{% end %}
						</h3>
						<h4 class="italic">{{ edu.title }}</h4>
						<small class="text-bgOffColor">
							<time>{{ edu.starts_at }}</time>
							-
							<time>{{ edu.ends_at }}</time>
						</small>
					</div>
					<div></div>
					{% if edu.description != "" %}
						<p class="!mb-0">{{ edu.description | raw }}</p>
					{% else %}
						<p class="!mb-0">No description available.</p>
					{% end %}
				</section>
			{% end %}
		</div>
	</section>
	<section id="contact" class="mb-8">
		<h2 id="contact" class="h2 ">🖋️ Contact</h2>
		<p>Here's a list of my contact information:</p>
		<ul class="list-inside list-[square] break-words">
			<li>Email: {{ this.Mail }}</li>
			<li>Ethereum Address: {{ this.EthAddress }}</li>
			<li>
				Monero Address: {{ this.MoneroAddress }}
			</li>
			<li>
				GPG Public key: <a hx-boost="false" href="/sachahjkl.gpg">{{ this.GpgPrint }}</a>
			</li>
			<li>
				LinkedIn Profile: <a href="{{ this.Linkedin }}">{{ this.Linkedin }}</a>
			</li>
			<li>
				GitHub Profile: <a href="{{ this.Github }}">{{ this.Github }}</a>
			</li>
			<li>
				GitLab Profile: <a href="{{ this.Gitlab }}">{{ this.Gitlab }}</a>
			</li>
		</ul>
	</section>
	<section id="project-build-status">
		<h2 id="project-build-status" class="h2">🏗️ Project Build Status</h2>
		<a href="https://gitlab.com/{{ this.Footer.gitRepoId }}/-/commit/{{ this.Footer.commitHash }}">
			<img width="300" src="https://gitlab.com/{{ this.Footer.gitRepoId }}/badges/master/pipeline.svg" loading="lazy" decoding="async" alt="Deploy Status Badge"/>
		</a>
	</section>
</article>
{% embed "_footer.temple.twig" with this.base %}
