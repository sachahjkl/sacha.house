{% embed "_header.temple.twig" with this.base %}
<article class="prose mx-auto">
    <p class="mb-4 text-sm">
        <a href="/admin" class="opacity-60 underline">
            <span class="inline-block rotate-180">➜</span>
            Go back to the admin page
        </a>
    </p>

    <h1 class="h1">manage blogposts</h1>

    <p>
        <a href="/admin/blogposts/new">Create a new blogpost -&gt;</a>
    </p>

    <div class="divider"></div>

    <section>
        <h2>All blogposts</h2>

        <label class="mb-4 flex max-w-xl flex-col gap-1">
            <span>Filter</span>
            <input id="blogposts-filter" type="text" placeholder="Filter by title, slug, or status" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0"/>
        </label>

        <p id="blogposts-filter-empty" class="mb-4 hidden text-sm opacity-70" role="status" aria-live="polite">
            No blogposts match this filter.
        </p>

        {% if len(this.Posts) == 0 %}
            <p>No blogposts yet.</p>
        {% end %}

        <ul id="blogposts-list" class="list-none pl-0">
            {% for post in this.Posts %}
                <li data-blogpost-item class="mb-4 border-2 border-textColor p-3">
                    <p class="!mb-1">
                        <a href="/admin/blogposts/{{ post.Slug }}">{{ post.Title }}</a>
                    </p>
                    <p class="!mb-1 text-sm opacity-70">
                        <code>{{ post.Slug }}</code>
                        /
                        {{ post.Status }}
                        /
                        updated {{ post.UpdatedAt }}
                    </p>
                    {% if post.PublishedAt != "" %}
                        <p class="!mb-1 text-sm opacity-70">published {{ post.PublishedAt }}</p>
                    {% end %}
                    <p class="!mb-0">
                        <a href="/admin/blogposts/{{ post.Slug }}">edit</a>
                        |
                        <a href="/blog/{{ post.Slug }}">view public page</a>
                    </p>
                </li>
            {% end %}
        </ul>
    </section>
</article>
{% embed "_footer.temple.twig" with this.base %}
