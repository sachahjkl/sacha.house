<div id="passkey-list">
    <h3 class="mt-6 text-lg font-bold">Registered passkeys</h3>
    {% if len(this.Passkeys) == 0 %}
        <p class="mt-2 opacity-70">No passkeys registered yet.</p>
    {% else %}
        <ul class="mt-3 space-y-[2px] pl-0 text-base">
            {% for passkey in this.Passkeys %}
                <li class="m-0 flex flex-wrap content-start justify-between gap-2 p-0">
                    <div class="min-w-0 flex flex-1 items-center gap-2">
                        <p class="!m-0 wrap-anywhere">{{ passkey.Label }}</p>
                        <code class="min-w-0 flex-1 truncate opacity-50">{{ passkey.Id }}</code>
                    </div>
                    <form method="POST" action="/admin/webauthn/remove" hx-post="/admin/webauthn/remove" hx-target="#passkey-list" hx-swap="outerHTML" class="shrink-0">
                        <input type="hidden" name="id" value="{{ passkey.Id }}"/>
                        <button type="submit" title="Unregister" aria-label="Unregister" class="h-8 select-none bg-red-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#991b1b_inset,0_0_0_1px_#dc2626_inset,0_0.5px_0_1.5px_#f87171_inset] hover:bg-red-700 active:bg-red-800">
                            Unregister
                        </button>
                    </form>
                </li>
            {% end %}
        </ul>
    {% end %}
</div>
