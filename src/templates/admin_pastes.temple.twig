{% embed "_header.temple.twig" with this.base %}
<article class="prose mx-auto">
    <p class="mb-4 text-sm">
        <a href="/admin" class="opacity-60 underline">
            <span class="inline-block rotate-180" aria-hidden="true">➜</span>
            Go back to the admin page
        </a>
    </p>

    <h1 class="h1">encrypted pastes</h1>

    {% if this.Error != "" %}
        <div class="mb-4 border-2 border-red-500 bg-red-100 p-3 text-red-800" role="alert" aria-live="assertive">{{ this.Error }}</div>
    {% end %}
    {% if this.Notice != "" %}
        <div class="mb-4 border-2 border-blue-300 bg-blue-100 p-3 text-blue-800" role="status" aria-live="polite">{{ this.Notice }}</div>
    {% end %}
    {% if this.Truncated %}
        <p class="mb-4 border-2 border-textColor p-3" role="status" aria-live="polite">
            This list is incomplete. Refresh after the storage limit or rate limit clears.
        </p>
    {% end %}

    <p><a href="/admin/pastes/new">Create an encrypted paste -&gt;</a></p>

    <div class="divider"></div>

    <section aria-labelledby="paste-list-heading">
        <h2 id="paste-list-heading">Owned encrypted Gists</h2>
        {% if len(this.Items) == 0 %}
            <p>No encrypted pastes are available.</p>
        {% end %}

        <ul class="list-none pl-0">
            {% for item in this.Items %}
                <li class="mb-4 border-2 border-textColor p-3">
                    <p class="!mb-1 font-bold">
                        {% if item.Title != "" %}{{ item.Title }}{% end %}
                        {% if item.Title == "" %}<span class="opacity-70">Plaintext unavailable</span>{% end %}
                    </p>
                    <dl class="!my-2 text-sm">
                        <dt class="font-bold">Status</dt>
                        <dd class="!ml-0">{{ item.Status }}</dd>
                        <dt class="font-bold">Gist ID</dt>
                        <dd class="!ml-0 wrap-anywhere"><code>{{ item.GistId }}</code></dd>
                        <dt class="font-bold">Paste ID</dt>
                        <dd class="!ml-0 wrap-anywhere"><code>{{ item.PasteId }}</code></dd>
                        <dt class="font-bold">Revision</dt>
                        <dd class="!ml-0 wrap-anywhere"><code>{{ item.Revision }}</code></dd>
                        <dt class="font-bold">Key</dt>
                        <dd class="!ml-0 wrap-anywhere"><code>{{ item.KeyId }}</code></dd>
                        <dt class="font-bold">Provider timestamps</dt>
                        <dd class="!ml-0">created {{ item.CreatedAt }} / updated {{ item.UpdatedAt }}</dd>
                    </dl>
                    {% if item.CanEdit %}
                        <div class="flex flex-wrap gap-3">
                            <a href="/admin/pastes/{{ item.GistId }}" class="inline-block h-10 border-2 border-textColor px-4 leading-10">Edit</a>
                            <form method="POST" action="/admin/pastes/{{ item.GistId }}/rotate">
                                <input type="hidden" name="csrf_token" value="{{ this.CsrfToken }}"/>
                                <input type="hidden" name="revision" value="{{ item.Revision }}"/>
                                <button type="submit" class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">
                                    {% if item.NeedsRotation %}Rotate to active key{% end %}
                                    {% if !item.NeedsRotation %}Re-encrypt{% end %}
                                </button>
                            </form>
                        </div>
                    {% end %}
                </li>
            {% end %}
        </ul>
    </section>
</article>
{% embed "_footer.temple.twig" with this.base %}
