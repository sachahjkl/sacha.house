{% embed "_header.temple.twig" with this.base %}
<article class="prose mx-auto">
    <p class="mb-4 text-sm">
        <a href="/admin" class="opacity-60 underline">
            <span class="inline-block rotate-180">➜</span>
            Go back to the admin page
        </a>
    </p>

    <h1 class="h1">manage passkeys</h1>

    <section>
        <h2>🔐 WebAuthn Passkeys</h2>
        <div class="mb-4">
            <p>Register, label, test, and remove WebAuthn passkeys for this admin panel.</p>
            <label for="passkey-label" class="mt-4 block text-sm font-bold">Passkey label</label>
            <input
                id="passkey-label"
                name="label"
                type="text"
                maxlength="80"
                placeholder="YubiKey 5 NFC"
                class="mt-2 block w-full max-w-md border border-current bg-transparent px-3 py-2"
            />
            <div class="mt-4 flex flex-wrap gap-2">
                <button onclick="registerPasskey()" class="h-8 select-none bg-green-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#166534_inset,0_0_0_1px_#15803d_inset,0_0.5px_0_1.5px_#4ade80_inset] hover:bg-green-700 active:bg-green-800">
                    🔑 Register New Passkey
                </button>
                <button onclick="testPasskey()" class="h-8 select-none bg-blue-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">
                    🧪 Test Passkey
                </button>
            </div>
            <div id="passkey-status" class="mt-4 hidden p-3"></div>

            {% embed "_admin_passkey_list.temple.twig" with this.Passkeys %}

            <h3 class="mt-6 text-lg font-bold">Passkey toy debug form</h3>
            <p class="mt-2">Run a WebAuthn assertion and dump some browser/authenticator details.</p>
            <form id="passkey-debug-form" class="mt-3 flex flex-wrap items-end gap-3" onsubmit="debugPasskey(event)">
                <label class="block text-sm">
                    <span class="mb-1 block font-bold">User verification</span>
                    <select id="passkey-debug-user-verification" class="h-10 border-2 border-textColor bg-bgColor px-3 text-textColor focus:outline-none focus:ring-0">
                        <option value="preferred" class="bg-bgColor text-textColor">preferred</option>
                        <option value="required" class="bg-bgColor text-textColor">required</option>
                        <option value="discouraged" class="bg-bgColor text-textColor">discouraged</option>
                    </select>
                </label>
                <button type="submit" class="h-8 select-none bg-zinc-700 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#27272a_inset,0_0_0_1px_#3f3f46_inset,0_0.5px_0_1.5px_#a1a1aa_inset] hover:bg-zinc-800 active:bg-black">
                    Debug YubiKey
                </button>
            </form>
            <pre id="passkey-debug-output" class="wrap-anywhere mt-3 hidden overflow-x-auto border border-current p-3 text-xs"></pre>
        </div>
    </section>
</article>
{% embed "_footer.temple.twig" with this.base %}
