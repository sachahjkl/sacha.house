{% embed "_header.temple.twig" with this.base %}
	<p class="mb-4 text-sm">
		<a href="/blog" class="opacity-60 underline">
			<span class="inline-block rotate-180">➜</span>
			Go back to the articles list
		</a>
	</p>
	<h1 class="h1">{{ this.Post.title }}</h1>
	<small class="text-textColor/50 text-sm">
by
{{ this.Post.author }}
-

		created on
		{{ this.Post.createdOn }}
		at
		{{ this.Post.createdAtTime }}
		- last modified on
		{{ this.Post.updatedOn }}
		at
		{{ this.Post.updatedAtTime }}
	</small>
	<article class="prose mt-4">
		{{ this.Post.content.html | raw }}
	</article>

	{% embed "_footer.temple.twig" with this.base %}
