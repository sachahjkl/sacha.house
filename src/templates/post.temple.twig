{% embed "_header.temple.twig" with this.base %}
	<p class="mb-4 text-sm">
		<a href="/blog" class="opacity-60 underline">
			<span class="inline-block rotate-180">➜</span>
			Go back to the articles list
		</a>
	</p>
	<hgroup class="mb-4">
		<h1 class="h1 mb-0">{{ this.Post.title }}</h1>
		<small class="text-textColor/50 text-sm">
			crea:
			<span title="created on {{ this.Post.createdOn }} at {{ this.Post.createdAtTime }}">{{ this.Post.createdOn }}</span>
			/ upd:
			<span title="last updated on {{ this.Post.updatedOn }} at {{ this.Post.updatedAtTime }}">{{ this.Post.updatedOn }}</span>

		</small>
	</hgroup>
	<article class="prose">
		{{ this.Post.content.html | raw }}
	</article>

	{% embed "_footer.temple.twig" with this.base %}
