package web

import (
	"fmt"
)

templ Head(data PageData) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title id="page-title">{ data.Title }</title>
		<meta name="description" content={ data.SEO.Description }/>
		<meta name="author" content={ data.SEO.Author }/>
		if data.SEO.NoIndex {
			<meta name="robots" content="noindex"/>
		} else {
			<link rel="canonical" href={ templ.SafeURL(data.SEO.URL) }/>
		}
		<meta property="og:site_name" content="sacha.house"/>
		<meta property="og:title" content={ data.Title }/>
		<meta property="og:description" content={ data.SEO.Description }/>
		<meta property="og:type" content={ data.SEO.Type }/>
		<meta property="og:url" content={ data.SEO.URL }/>
		<meta property="og:image" content={ data.SEO.Image }/>
		<meta property="og:locale" content={ data.Locale() }/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff"/>
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000"/>
		<link rel="alternate" type="application/rss+xml" title="sacha.house blog (RSS)" href="/blog/rss.xml"/>
		<link rel="alternate" type="application/atom+xml" title="sacha.house blog (Atom)" href="/blog/atom.xml"/>
		<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png"/>
		<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png"/>
		<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="mask-icon" href="/static/safari-pinned-tab.svg" color="#000000"/>
		<link rel="preload" href="/static/fonts/fira-code/fira-code-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ templ.SafeURL("/static/css/style.css?v=" + data.StyleVersion) }/>
		if !data.AdminScripts {
			<script defer src={ templ.SafeURL("/static/js/christmas.js?v=" + data.StyleVersion) }></script>
		}
		if data.PostScripts {
			<script defer src={ templ.SafeURL("/static/js/post.js?v=" + data.StyleVersion) }></script>
		}
		if data.AdminScripts {
			<script type="module" src={ templ.SafeURL("/static/js/datastar.js?v=" + data.StyleVersion) }></script>
			<script defer src={ templ.SafeURL("/static/js/admin.js?v=" + data.StyleVersion) }></script>
		}
	</head>
}

templ Document(data PageData, body templ.Component) {
	<!doctype html>
	<html lang={ data.Language }>
		@Head(data)
		<body id="page-body" class="site bg-bgColor text-textColor">
			<a class="skip-link" href="#main">Skip to content</a>
			@Header(data)
			<main id="main" class="site-main">@body</main>
			@SiteFooter(data)
		</body>
	</html>
}

templ BareDocument(data PageData, body templ.Component) {
	<!doctype html>
	<html lang={ data.Language }>
		@Head(data)
		<body id="page-body" class="bg-bgColor text-textColor">
			@body
		</body>
	</html>
}

templ Header(data PageData) {
	<header class="site-header">
		<nav class="site-nav" aria-label="Main">
			<a class="site-mark" href="/" if data.HomeIsActive { aria-current="page" }>sacha.house</a>
			<ul>
				for _, item := range data.NavItems {
					<li><a href={ templ.SafeURL(item.Pathname) } class={ templ.KV("active", item.IsActive) } if item.IsActive { aria-current="page" }>@Icon(item.Icon)
{ item.Title }</a></li>
				}
			</ul>
		</nav>
	</header>
}

templ SiteFooter(data PageData) {
	<footer class="site-footer">
		<p>sacha.house (C) { fmt.Sprintf("%d", data.Footer.Year) }</p>
		<ul>
			<li><a href="/blog/rss.xml">rss</a></li>
			<li><a href="/keys">keys</a></li>
			<li><a href={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID) }>source</a></li>
			<li><a href="/admin">admin</a></li>
			<li><a href={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID + "/commit/" + data.Footer.CommitHash) }>{ data.Footer.Version }</a></li>
		</ul>
		if data.HotReload {
			<script src="/static/js/hot-reload.js"></script>
		}
	</footer>
}

templ ASCIILogo() {
	<pre class="inline-block text-transparent bg-clip-text ascii-logo ascii-logo-fire whitespace-pre" role="img" aria-label="House of Sacha, in letters of fire">@templ.Raw(asciiLogo)</pre>
}
