package web

import (
	"fmt"
)

templ Head(data PageData) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title id="page-title">{ data.Title }</title>
		<link rel="icon" href="/static/favicon_shadow.png"/>
		<link rel="dns-prefetch" href="https://fonts.googleapis.com"/>
		<link rel="dns-prefetch" href="https://fonts.gstatic.com"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Mono:wght@400&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="stylesheet"/></noscript>
		<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
		<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png"/>
		<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="mask-icon" href="/static/safari-pinned-tab.svg" color="#000000"/>
		<meta name="msapplication-TileColor" content="#000000"/>
		<meta name="theme-color" content="#ffffff"/>
		<link rel="stylesheet" href={ templ.SafeURL("/static/css/style.css?v=" + data.StyleVersion) }/>
		<meta name="description" content={ data.SEO.Description }/>
		<meta property="og:description" content={ data.SEO.Description }/>
		<meta name="twitter:description" content={ data.SEO.Description }/>
		<meta name="twitter:image" content={ data.SEO.Image }/>
		<meta property="og:image" content={ data.SEO.Image }/>
		<meta name="keywords" content="Blog, Programmation, Programming, Portfolio, Personal, Personnel"/>
		<meta name="generator" content="Go"/>
		<meta property="og:locale" content="fr_FR"/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="author" content={ data.SEO.Author }/>
		if data.AdminScripts {
			<script type="module" src={ templ.SafeURL("/static/js/datastar.js?v=" + data.StyleVersion) }></script>
			<script defer src={ templ.SafeURL("/static/js/admin.js?v=" + data.StyleVersion) }></script>
		}
	</head>
}

templ Document(data PageData, body templ.Component) {
	<!doctype html>
	<html lang={ data.Language }>
		@Head(data)
		<body id="page-body" class="bg-bgColor text-textColor">
			@Header(data)
			<main id="main" class="m-auto max-w-5xl p-3 pb-16">@body</main>
			@SiteFooter(data)
		</body>
	</html>
}

templ BareDocument(data PageData, body templ.Component) {
	<!doctype html>
	<html lang={ data.Language }>
		@Head(data)
		<body id="page-body" class="bg-bgColor text-textColor">
			@body
		</body>
	</html>
}

templ Header(data PageData) {
	<header class="bg-bgColor sticky top-0 z-10 px-3">
		<nav>
			<fieldset class="border-textColor border-2 p-2 px-4">
					<legend class="ml-3 px-2">Navigation</legend>
				<ul class="hidden flex-wrap gap-3 whitespace-nowrap sm:flex">
					for index, item := range data.NavItems {
						<li class="flex-[100%] sm:flex-none"><a href={ templ.SafeURL(item.Pathname) } class={ templ.KV("active", item.IsActive) } if item.IsActive { aria-current="page" }>{ item.Icon } { item.Title }</a></li>
						if index < len(data.NavItems)-1 {
							<li class="border-textColor hidden border-r-2 sm:inline-block"></li>
						}
					}
				</ul>
				<div class="block sm:hidden">
					<details>
						<summary id="nav-summary" class="mb-1">Open navigation</summary>
						<ul class="flex flex-wrap gap-3 whitespace-nowrap">
							for index, item := range data.NavItems {
								<li class="flex-[100%] sm:flex-none"><a class={ "inline-block w-full", templ.KV("active", item.IsActive) } href={ templ.SafeURL(item.Pathname) } if item.IsActive { aria-current="page" }>{ item.Icon } { item.Title }</a></li>
								if index < len(data.NavItems)-1 {
									<li class="border-textColor hidden border-r-2 sm:inline-block"></li>
								}
							}
						</ul>
					</details>
				</div>
			</fieldset>
		</nav>
	</header>
}

templ SiteFooter(data PageData) {
	<footer class="bg-textColor text-bgColor fixed bottom-0 flex w-full flex-wrap items-center justify-between gap-2 px-2 py-1 font-bold text-sm">
		<div><p>sacha.house (C) { fmt.Sprintf("%d", data.Footer.Year) }</p></div>
		<div class="flex items-center gap-2"><a class="underline" href={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID + "/commit/" + data.Footer.CommitHash) }>{ data.Footer.Version }</a></div>
		if data.HotReload {
			<script src="/static/js/hot-reload.js"></script>
		}
	</footer>
}

templ ASCIILogo() {
	<pre class="inline-block text-transparent bg-clip-text ascii-logo ascii-logo-fire whitespace-pre" aria-label="sacha.house ASCII logo">@templ.Raw(asciiLogo)</pre>
}
