package web

import "fmt"

templ CareerPage(data CareerPageData) {
	<!doctype html>
	<html lang={ data.Profile.Language }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/static/css/cv.css"/>
			<title id="page-title">{ data.PageData.Title }</title>
			<meta name="description" content={ data.PageData.SEO.Description }/>
		</head>
		<body id="page-body">
			@CareerContent(data)
		</body>
	</html>
}

templ CareerContent(data CareerPageData) {
	<main id="main" class={ "page", templ.KV("cv-full", data.Full), templ.KV("cv-resume", !data.Full) }>
		<nav class="document-controls no-print" aria-label="Document controls">
			<div>
				<a href={ templ.SafeURL(careerPath(false, data.Profile.Language)) } class={ templ.KV("active", !data.Full) }>{ data.Profile.ResumeLabel }</a>
				<a href={ templ.SafeURL(careerPath(true, data.Profile.Language)) } class={ templ.KV("active", data.Full) }>{ data.Profile.CVLabel }</a>
			</div>
			<div>
				<a href="/">← retour à sacha.house</a>
				<a href={ templ.SafeURL(careerPath(data.Full, data.Profile.OtherLanguage)) } lang={ data.Profile.OtherLanguage }>{ data.Profile.OtherLanguageLabel }</a>
				<button type="button" onclick="window.print()">{ data.Profile.PrintLabel }</button>
			</div>
		</nav>
		<header id="intro">
			<img src="/static/me-portrait.jpg" height="100" width="100" alt={ data.FullName } class="photo"/>
			<div class="identity">
				<h1>{ data.FullName }</h1>
				<p class="contact">
					<span>{ data.Profile.LocationLabel }</span>
					<span><a href={ templ.SafeURL("mailto:" + data.Mail) }>{ data.Mail }</a></span>
					<span>{ fmt.Sprintf("%d %s", data.Age, data.Profile.AgeLabel) }</span>
					<span>{ data.Profile.Nationality }</span>
				</p>
			</div>
		</header>

		<section>
			<h2>{ data.Profile.EducationLabel }</h2>
			for _, education := range data.Profile.Education {
				if data.Full || !education.FullOnly {
					<div class="entry education-entry">
						<div class="entry-head">
							<span><strong class="entry-title">{ education.School }</strong> <span class="entry-sep">·</span> <em>{ education.Degree }</em></span>
							<span class="entry-date">{ education.Period }</span>
						</div>
						if data.Full {
							<p class="cv-meta">{ education.Description }</p>
						}
					</div>
				}
			}
		</section>

		<section>
			<h2>{ data.Profile.ExperienceLabel }</h2>
			for _, experience := range data.Profile.Experiences {
				if data.Full || !experience.FullOnly {
					<div class="entry">
						<div class="entry-head">
							<strong class="entry-title">{ experience.Company }</strong>
							if experience.Context != "" {
								<span class="entry-aside">{ experience.Context }</span>
							}
						</div>
						<div class="entry-head entry-sub">
							<em>{ experience.Role }</em>
							<span class="entry-date">{ experience.Period }</span>
						</div>
						if data.Full {
							<div class="experience-description">
								<p>{ experience.Summary }</p>
								for _, detail := range experience.Details {
									<h3>{ detail.Title }</h3>
									<p>{ detail.Text }</p>
								}
							</div>
						} else if len(experience.Highlights) > 0 {
							<ul class="cv-bullets">
								for _, highlight := range experience.Highlights {
									<li><strong>{ highlight.Lead }</strong> { highlight.Text }</li>
								}
							</ul>
						}
						if experience.Environment != "" {
							<p class="stack"><strong>{ data.Profile.EnvironmentLabel } :</strong> <em>{ experience.Environment }</em></p>
						}
					</div>
				}
			}
		</section>

		<section>
			<h2>{ data.Profile.ProjectsLabel }</h2>
			for index, project := range data.Profile.Projects {
				if data.Full || index < 3 {
					<div class="entry">
						<div class="entry-head">
							<strong class="entry-title entry-name"><a href={ templ.SafeURL(project.URL) }>{ project.Name }</a></strong>
							if project.Stack != "" {
								<span class="entry-aside">{ project.Stack }</span>
							}
						</div>
						<ul class="cv-bullets">
							if data.Full || project.Summary == "" {
								<li>{ project.Description }</li>
							} else {
								<li>{ project.Summary }</li>
							}
						</ul>
					</div>
				}
			}
			<p class="cv-meta"><a href="https://sacha.house/projects">https://sacha.house/projects</a></p>
		</section>

		if data.Full {
			<section>
				<h2>{ data.Profile.CatalogLabel }</h2>
				for _, group := range data.Profile.Catalog {
					<p><strong>{ group.Title } :</strong> { joinCareerItems(group.Items) }</p>
				}
			</section>

			<section>
				<h2>{ data.Profile.PublicationsLabel }</h2>
				for _, publication := range data.Profile.Publications {
					<div class="entry-head">
						<a href={ templ.SafeURL(publication.URL) }>{ publication.Title }</a>
						<span class="entry-date">{ publication.Date }</span>
					</div>
				}
			</section>
		}

		<section>
			<h2>{ data.Profile.LanguagesLabel }</h2>
			<p>{ joinCareerItems(data.Profile.Languages) }</p>
		</section>
	</main>
}
