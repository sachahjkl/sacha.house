package web

import (
	"fmt"
)

templ HomePage(data HomePageData, navigation Navigation) {
	@Document(data.PageData, navigation, HomeContent(data))
}

templ HomeContent(data HomePageData) {
	<article>
		<h1 class="h1">welcome to my website</h1>
		<section class="mb-8"><div class="ascii-logo-wrap ascii-logo-wrap-hero">@ASCIILogo()</div></section>
		<section class="mb-8">
			<h2 class="h2">Quick links</h2>
			<ul>
				<li><a href="/about">➜ about me</a></li>
				<li>📄 my <a href={ templ.SafeURL(data.CV) }>curriculum vitae</a> and <a href={ templ.SafeURL(data.Resume) }>résumé</a></li>
				<li><a href={ templ.SafeURL("mailto:" + data.Mail) }>📧 shoot me an email (will reply asap)</a></li>
				<li><a href="/sachahjkl.pub" target="_blank" rel="noopener noreferrer">🔐 my ssh public key</a></li>
			</ul>
		</section>
		<section class="mb-8"><picture><img class="m-auto w-full max-w-md" src="/static/c-omrade.jpg" width="1000" height="1305" alt="comrade" fetchpriority="high"/></picture></section>
	</article>
}

templ AboutPage(data AboutPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AboutContent(data))
}

templ AboutContent(data AboutPageData) {
	<article class="about-page mx-auto max-w-full text-sm sm:text-base print:max-w-full">
		<h1 class="h1">about</h1>
		<section class="mb-8">
			<div class="avatar my-6 flex justify-center"><picture class="border-textColor block border-4"><img class="me" src="/static/me.jpg" height="400" width="400" alt="Moi"/></picture></div>
			<p>My name is <b>{ data.FirstName }</b>, I'm <em>{ fmt.Sprintf("%d years old", data.Age) }</em> and I live in <em>{ data.PlaceOfLiving }</em>.</p>
			<p>I'm a software engineer. I strive to produce simple, high-quality work.</p>
			<p>Feel free to <a class="underline" href={ templ.SafeURL("mailto:" + data.Mail) }>send me an email</a> about what you think of this site or any other topic that might interest me (work, discussion, project, ...).</p>
			<p>You can <b>find my curriculum vitae</b> by clicking <a class="underline" href={ templ.SafeURL(data.CurriculumVitae) }>here</a>.</p>
		</section>
		<section class="mb-8" id="professional-details">
			<h2 class="h2">🖥️ Professional Details</h2>
			<div class="flex flex-col gap-4">
				for _, experience := range data.LinkedInExperiences {
					<section class="border-textColor border-s-[16px] py-2 ps-4">
						<div class="mb-3"><h3 class="ms-0 font-bold">
							if experience.CompanyLinkedInProfileURL != "" {
								<a class="font-bold no-underline hover:underline" href={ templ.SafeURL(experience.CompanyLinkedInProfileURL) }>{ experience.Company } 🔗</a>
							} else {
								{ experience.Company }
							}
						</h3><h4 class="italic">{ experience.Title }</h4><small class="text-bgOffColor"><time>{ experience.StartsOn() }</time> - <time>{ experience.EndsOn() }</time></small></div>
						<div></div><p class="!mb-0">@templ.Raw(experience.Description)</p>
					</section>
				}
			</div>
		</section>
		<section class="mb-8" id="academic-background">
			<h2 class="h2">🏫 Academic Background</h2>
			<div class="flex flex-col gap-4">
				for _, education := range data.LinkedInEducation {
					<section class="border-textColor border-s-[16px] py-2 ps-4">
						<div class="mb-3"><h3 class="ms-0 font-bold">
							if education.SchoolLinkedInProfileURL != "" {
								<a class="font-bold no-underline hover:underline" href={ templ.SafeURL(education.SchoolLinkedInProfileURL) }>{ education.School } 🔗</a>
							} else {
								{ education.School }
							}
						</h3><h4 class="italic">{ education.Title() }</h4><small class="text-bgOffColor"><time>{ education.StartsOn() }</time> - <time>{ education.EndsOn() }</time></small></div>
						<div></div>
						if education.Description != "" {
							<p class="!mb-0">@templ.Raw(education.Description)</p>
						} else {
							<p class="!mb-0">No description available.</p>
						}
					</section>
				}
			</div>
		</section>
		<section id="contact" class="mb-8">
			<h2 class="h2">🖋️ Contact</h2><p>Here's a list of my contact information:</p>
			<ul class="list-inside list-[square] break-words">
				<li>Email: { data.Mail }</li><li>Ethereum Address: { data.ETHAddress }</li><li>Monero Address: { data.MoneroAddress }</li>
				<li>GPG Public key: <a href="/sachahjkl.gpg">{ data.GPGFingerprint }</a></li>
				<li>LinkedIn Profile: <a href={ templ.SafeURL(data.LinkedIn) }>{ data.LinkedIn }</a></li>
				<li>GitHub Profile: <a href={ templ.SafeURL(data.GitHub) }>{ data.GitHub }</a></li>
				<li>GitLab Profile: <a href={ templ.SafeURL(data.GitLab) }>{ data.GitLab }</a></li>
			</ul>
		</section>
		<section id="project-build-status"><h2 class="h2">🏗️ Project Build Status</h2><a href={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID + "/commit/" + data.Footer.CommitHash) }><img width="300" src={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID + "/actions/workflows/build.yml/badge.svg?branch=master") } loading="lazy" decoding="async" alt="Build Status Badge"/></a></section>
	</article>
}

templ ProjectsPage(data ProjectsPageData, navigation Navigation) {
	@Document(data.PageData, navigation, ProjectsContent(data))
}

templ ProjectsContent(data ProjectsPageData) {
	<article class="mx-auto">
		<h1 class="h1">projects</h1>
		<section class="mb-8"><p>A collection of my work, including both completed and ongoing projects. These repositories were created to:</p>
			<ul class="ms-4 list-inside list-[square]"><li>Explore new technologies</li><li>Practice project management, design, and software architecture</li><li>Collaborate on personal projects</li><li>Organize academic work</li><li>Store personal environment files</li></ul>
			<p>My public projects are hosted on <b>GitHub</b>.</p>
		</section>
		<section class="mb-8"><h2 class="h2 mb-0"><img class="m-0 mr-2 inline-block w-[1.2em] align-middle" src="/static/github.png" alt=""/> GitHub / @{ data.Username }</h2>@ProjectList(data.Projects)</section>
	</article>
}

templ ProjectList(projects []ProjectView) {
	<ul class="scrollbar-thin border-textColor mx-4 flex max-h-[540px] snap-y snap-mandatory list-none flex-col gap-4 overflow-y-scroll border-y-4 p-0">
		for _, project := range projects {
			<li class="snap-start"><div class="border-bgColor bg-bgColor text-textColor hover:border-textColor flex overflow-hidden border-4">
				if project.HasAvatar {
					<div class="grid shrink-0 place-content-center"><img class="aspect-square max-w-fit size-16 sm:size-32" loading="lazy" src={ templ.SafeURL(project.AvatarURL) } alt=""/></div>
				} else {
					<div style={ "background-color: " + project.HSLColor + ";" } class="grid aspect-square size-16 shrink-0 place-content-center sm:size-32" aria-hidden="true"><span class="shadow-sm flex h-12 w-12 place-content-center place-items-center rounded bg-neutral-900/50 text-center text-3xl text-neutral-100">{ project.FirstLetter }</span></div>
				}
				<div class="text-textColor flex w-full min-w-0 flex-col overflow-hidden p-0 text-sm sm:text-base"><h2 class="bg-textColor text-bgColor ps-2 font-bold"><a class="block" href={ templ.SafeURL(project.URL) }>{ project.Name }</a></h2><div class="line-clamp-2 flex-1 ps-2 pt-2">
					if project.DescriptionHTML != "" {
						@templ.Raw(project.DescriptionHTML)
					} else {
						😞 Unfortunately, no description is available (I was probs lazy ahh).
					}
				</div>
				if project.LastCommitURL != "" {
					<small class="text-textColor/60 px-2 pb-1"><time datetime={ project.LastCommitTime }>{ project.LastCommitDate }</time> · <a class="underline" href={ templ.SafeURL(project.LastCommitURL) }>{ project.LastCommitHash }</a></small>
				}
				</div>
			</div></li>
		}
	</ul>
}

templ BlogPage(data BlogPageData, navigation Navigation) {
	@Document(data.PageData, navigation, BlogContent(data))
}

templ BlogContent(data BlogPageData) {
	<article class="blog-page">
		<h1 class="h1 flex items-center gap-2">blog <a href="/blog/rss.xml" target="_blank" title="RSS Feed" class="opacity-50 hover:opacity-100"><img src="/static/rss.svg" alt="RSS Feed" class="h-6 w-6"/></a><a href="/blog/atom.xml" target="_blank" title="Atom Feed" class="opacity-50 hover:opacity-100"><img src="/static/atom.svg" alt="Atom Feed" class="h-6 w-6"/></a></h1>
		<h2 class="mb-2 font-bold">📰 Available articles</h2>
		if len(data.YearGroups) == 0 {
			<p>No articles yet.</p>
		}
		for _, group := range data.YearGroups {
			<h3 class="text-xl font-bold mt-4 mb-2">{ fmt.Sprintf("%d", group.Year) }</h3><ul class="list-inside list-[square]">
				for _, post := range group.Posts {
					<li><a href={ templ.SafeURL("/blog/" + post.Slug) } if post.Excerpt != "" { aria-describedby={ "excerpt-" + post.Slug } }>{ post.Title }</a>
						if post.Excerpt != "" {
							<p id={ "excerpt-" + post.Slug } class="wrap-anywhere mb-3 mt-1 list-none text-sm opacity-70">{ post.Excerpt }</p>
						}
					</li>
				}
			</ul>
		}
	</article>
}

templ PostPage(data PostPageData, navigation Navigation) {
	@Document(data.PageData, navigation, PostContent(data))
}

templ PostContent(data PostPageData) {
	<p class="mb-4 text-sm"><a href="/blog" class="opacity-60 underline"><span class="inline-block rotate-180">➜</span> Go back to the articles list</a></p>
	<header class="mb-4"><h1 class="h1 mb-0">{ data.Post.Title }</h1><p class="text-textColor/50 text-sm">crea: <span title={ "created on " + data.Post.CreatedOn + " at " + data.Post.CreatedAtTime }>{ data.Post.CreatedOn }</span> / upd: <span title={ "last updated on " + data.Post.UpdatedOn + " at " + data.Post.UpdatedAtTime }>{ data.Post.UpdatedOn }</span></p></header>
	<article class="prose">@templ.Raw(data.Post.HTML)</article>
}

templ TeapotPage(data TeapotPageData, navigation Navigation) {
	@BareDocument(data.PageData, navigation, TeapotContent(data))
}

templ TeapotContent(data TeapotPageData) {
	if data.IsATeapot {
		<main id="main" class="m-auto mt-16 max-w-5xl p-4"><h1>418 I'm a teapot</h1><p>{ data.BrewMessage.Text }</p></main>
	} else {
		<main id="main" class="m-auto mt-6 max-w-5xl p-4"><p><a href="/" class="opacity-60"><span class="inline-block rotate-180">➜</span> Home</a></p><h1 class="h1">Here, let's make you a nice cup of :</h1><ul><li><a href="?drink=tea">Tea</a></li><li><a href="?drink=coffee">Coffee</a></li><li><a href={ templ.SafeURL("?drink=" + data.Spewage) }>Random spewage</a></li></ul>
			if data.BrewMessage.Text != "" {
				<hr class="my-4 border-2"/><p class="text-center text-4xl font-black">{ data.BrewMessage.Text }</p><p class="mt-20 animate-bounce text-center text-9xl drop-shadow-md">{ data.BrewMessage.Emoji }</p>
			}
		</main>
	}
}
