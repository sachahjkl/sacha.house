package web

import (
	"fmt"
)

templ HomePage(data HomePageData) {
	@Document(data.PageData, HomeContent(data))
}

templ HomeContent(data HomePageData) {
	<article class="home">
		<div class="ascii-logo-wrap ascii-logo-wrap-hero">@ASCIILogo()</div>
		<section class="intro">
			<div>
				<h1 class="h1">hi, i'm sacha</h1>
				<p>I'm a software engineer in France. At work I take on the foundational jobs: framework migrations, faster tests and CI, performance, design systems. I measure before acting.</p>
				<p>At home I build my own tools, from a web browser to a GUI toolkit, and I run them on my own homelab.</p>
				<p class="actions">
					<a class="btn" href={ templ.SafeURL(data.Resume) }>@Icon("page-facing-up")
résumé</a>
					<a class="btn" href={ templ.SafeURL(data.CV) }>full cv</a>
					<a class="btn" href={ templ.SafeURL("mailto:" + data.Mail) }>@Icon("e-mail")
shoot me an email</a>
				</p>
				<p class="meta">Will reply asap.</p>
			</div>
			<picture class="poster"><img src="/static/c-omrade.jpg" width="1000" height="1305" alt="Poster of two hands holding up The C Programming Language" fetchpriority="high"/></picture>
		</section>
		<div class="panes">
			if len(data.Projects) > 0 {
				<section class="pane">
					<h2 class="pane-title">now building</h2>
					<ul class="project-list">
						for _, project := range data.Projects {
							@ProjectCard(project)
						}
					</ul>
					<p class="pane-more"><a href="/projects">
						all { fmt.Sprintf("%d", data.ProjectCount) } projects
						@ArrowRightEnd()
					</a></p>
				</section>
			}
			if len(data.Posts) > 0 {
				<section class="pane">
					<h2 class="pane-title">latest writing</h2>
					<ul class="post-list">
						for _, post := range data.Posts {
							@PostRow(post)
						}
					</ul>
					<p class="pane-more"><a href="/blog">
						all articles
						@ArrowRightEnd()
					</a></p>
				</section>
			}
		</div>
		<section class="pane pane-wide">
			<h2 class="pane-title">find me</h2>
			<ul class="link-row">
				<li><a href="/about">about me</a></li>
				<li><a href={ templ.SafeURL("mailto:" + data.Mail) }>{ data.Mail }</a></li>
				<li><a href={ templ.SafeURL(Me.GitHub) }>github</a></li>
				<li><a href={ templ.SafeURL(Me.LinkedIn) }>linkedin</a></li>
				<li><a href="/ssh">ssh</a> and <a href="/gpg">gpg</a> <a href="/keys">public keys</a></li>
			</ul>
		</section>
	</article>
}

templ AboutPage(data AboutPageData) {
	@Document(data.PageData, AboutContent(data))
}

templ AboutContent(data AboutPageData) {
	<article class="about-page">
		<h1 class="h1">about</h1>
		<section class="about-intro">
			<div class="avatar"><picture><img class="me" src="/static/me.jpg" height="400" width="400" alt="Portrait of Sacha Froment"/></picture></div>
			<div>
				<p>My name is <b>{ data.FullName }</b>, I'm <em>{ fmt.Sprintf("%d years old", data.Age) }</em> and I live in <em>{ data.PlaceOfLiving }</em>.</p>
				<p>{ data.Career.Summary }</p>
				<p>I strive to produce simple, high-quality work.</p>
				<p>Feel free to <a href={ templ.SafeURL("mailto:" + data.Mail) }>send me an email</a> about what you think of this site or any other topic that might interest me (work, discussion, project, ...).</p>
			</div>
		</section>
		<section id="career" class="mb-10">
			<h2 class="h2">career</h2>
			<ol class="timeline">
				for _, experience := range data.Career.Experiences {
					if !experience.FullOnly {
						<li>
							<span class="meta">{ experience.Period }</span>
							<span><b>{ experience.Company }</b>, { experience.Role }</span>
						</li>
					}
				}
			</ol>
			<p class="actions">
				<a class="btn" href="/resume?lang=en">one-page résumé</a>
				<a class="btn" href="/cv?lang=en">full cv</a>
			</p>
		</section>
		<section id="education" class="mb-10">
			<h2 class="h2">education</h2>
			<ol class="timeline">
				for _, education := range data.Career.Education {
					<li>
						<span class="meta">{ education.Period }</span>
						<span><b>{ education.School }</b>, { education.Degree }</span>
					</li>
				}
			</ol>
		</section>
		<section id="contact" class="mb-10">
			<h2 class="h2">contact</h2>
			<dl class="facts">
				<dt>email</dt>
				<dd><a href={ templ.SafeURL("mailto:" + data.Mail) }>{ data.Mail }</a></dd>
				<dt>github</dt>
				<dd><a href={ templ.SafeURL(data.GitHub) }>{ data.GitHub }</a></dd>
				<dt>linkedin</dt>
				<dd><a href={ templ.SafeURL(data.LinkedIn) }>{ data.LinkedIn }</a></dd>
				<dt>gpg</dt>
				<dd><a href="/gpg">{ data.GPGFingerprint }</a></dd>
				<dt>ssh</dt>
				<dd><a href="/ssh">public key</a></dd>
				<dt>ethereum</dt>
				<dd>{ data.ETHAddress }</dd>
				<dt>monero</dt>
				<dd>{ data.MoneroAddress }</dd>
			</dl>
		</section>
		<section id="colophon">
			<h2 class="h2">colophon</h2>
			<p>This site is a single Go binary built with templ and Tailwind CSS. Public pages need no JavaScript framework, and it runs from a Nix-built image on Nomad, in my homelab. The <a href={ templ.SafeURL("https://github.com/" + data.Footer.GitRepoID) }>source is on GitHub</a>.</p>
		</section>
	</article>
}

templ ProjectsPage(data ProjectsPageData) {
	@Document(data.PageData, ProjectsContent(data))
}

templ ProjectsContent(data ProjectsPageData) {
	<article>
		<h1 class="h1">projects</h1>
		<p class="lead">Everything public on <a href={ templ.SafeURL(data.GitHub) }>GitHub / @{ data.Username }</a>: { fmt.Sprintf("%d", len(data.Featured)+len(data.Others)) } repositories, from school assignments to the things I work on now.</p>
		if len(data.Featured) > 0 {
			<section class="mb-10">
				<h2 class="h2">selected</h2>
				<ul class="project-list project-grid">
					for _, project := range data.Featured {
						@ProjectCard(project)
					}
				</ul>
			</section>
		}
		if len(data.Others) > 0 {
			<section>
				<h2 class="h2">everything else</h2>
				<p class="meta mb-4">Latest commit first.</p>
				<ul class="ls">
					for _, project := range data.Others {
						<li>
							if project.LastCommitURL != "" {
								<a class="ls-date" href={ templ.SafeURL(project.LastCommitURL) }><time datetime={ project.LastCommitTime }>{ project.LastCommitDate }</time></a>
							} else {
								<span class="ls-date"></span>
							}
							<a class="ls-name" href={ templ.SafeURL(project.URL) }>{ project.Name }</a>
							<span class="ls-description">
								@templ.Raw(project.DescriptionHTML)
							</span>
						</li>
					}
				</ul>
			</section>
		}
	</article>
}

templ ProjectAvatar(project ProjectView) {
	if project.HasAvatar {
		<img class="project-avatar" loading="lazy" src={ templ.SafeURL(project.AvatarURL) } width="48" height="48" alt=""/>
	} else {
		<span class="project-avatar project-letter" style={ "background-color: " + project.HSLColor + ";" } aria-hidden="true">{ project.FirstLetter }</span>
	}
}

templ ProjectCard(project ProjectView) {
	<li class="project-card">
		@ProjectAvatar(project)
		<div class="min-w-0">
			<h3><a href={ templ.SafeURL(project.URL) }>{ project.Name }</a></h3>
			if project.DescriptionHTML != "" {
				<div class="project-description">
					@templ.Raw(project.DescriptionHTML)
				</div>
			}
			if project.LastCommitURL != "" {
				<p class="meta">
					<time datetime={ project.LastCommitTime }>{ project.LastCommitDate }</time> · <a href={ templ.SafeURL(project.LastCommitURL) }>{ project.LastCommitHash }</a>
					if project.LicenseLabel != "" {
						· <a href={ templ.SafeURL(project.LicenseURL) }>{ project.LicenseLabel }</a>
					}
				</p>
			}
		</div>
	</li>
}

templ PostRow(post PostView) {
	<li class="post-row">
		<a href={ templ.SafeURL("/blog/" + post.Slug) } if post.Excerpt != "" { aria-describedby={ "excerpt-" + post.Slug } }>{ post.Title }</a>
		<p class="meta">
			<time>{ post.PublishedOn }</time>
			if post.Language == "fr" {
				· en français
			}
		</p>
		if post.Excerpt != "" {
			<p id={ "excerpt-" + post.Slug } class="post-excerpt">{ post.Excerpt }</p>
		}
	</li>
}

templ BlogPage(data BlogPageData) {
	@Document(data.PageData, BlogContent(data))
}

templ BlogContent(data BlogPageData) {
	<article class="reading">
		<h1 class="h1">blog</h1>
		<p class="lead">Notes on what I build, and the occasional recipe. Follow along with <a href="/blog/rss.xml">rss</a> or <a href="/blog/atom.xml">atom</a>.</p>
		if len(data.YearGroups) == 0 {
			<p>No articles yet.</p>
		}
		for _, group := range data.YearGroups {
			<h2 class="h2 mt-8">{ fmt.Sprintf("%d", group.Year) }</h2>
			<ul class="post-list">
				for _, post := range group.Posts {
					@PostRow(post)
				}
			</ul>
		}
	</article>
}

templ PostPage(data PostPageData) {
	@Document(data.PageData, PostContent(data))
}

templ PostContent(data PostPageData) {
	<div class="reading">
		<p class="mb-4 text-sm"><a href="/blog">@ArrowLeft()
all articles</a></p>
		<header class="mb-6">
			<h1 class="h1 mb-1">{ data.Post.Title }</h1>
			<p class="meta">
				<span title={ "created on " + data.Post.CreatedOn + " at " + data.Post.CreatedAtTime }>{ data.Post.CreatedOn }</span>
				if data.Post.UpdatedOn != data.Post.CreatedOn {
					· updated <span title={ "last updated on " + data.Post.UpdatedOn + " at " + data.Post.UpdatedAtTime }>{ data.Post.UpdatedOn }</span>
				}
			</p>
		</header>
		if len(data.Post.TOC) >= 4 {
			<nav class="toc" aria-label="Table of contents">
				<details open>
					<summary>Contents</summary>
					<ol>
						for _, item := range data.Post.TOC {
							<li class={ templ.KV("toc-sub", item.Level > 2) }><a href={ templ.SafeURL("#" + item.ID) }>{ item.Title }</a></li>
						}
					</ol>
				</details>
			</nav>
		}
		<article class="prose">@templ.Raw(data.Post.HTML)</article>
		<p class="post-end"><a href="/blog">@ArrowLeft()
all articles</a><a href={ templ.SafeURL("mailto:" + Me.Mail + "?subject=" + data.Post.Slug) }>reply by email</a></p>
	</div>
}

templ NotFoundPage(data NotFoundPageData) {
	@Document(data.PageData, NotFoundContent(data))
}

templ NotFoundContent(data NotFoundPageData) {
	<article class="not-found">
		<h1 class="h1">404</h1>
		<div class="terminal">
			<p><span class="prompt">$</span> cat { data.Path }</p>
			<p>cat: { data.Path }: no such room in this house</p>
		</div>
		<p class="actions">
			<a class="btn" href="/">home</a>
			<a class="btn" href="/projects">projects</a>
			<a class="btn" href="/blog">blog</a>
			<a class="btn" href="/teapot">make some tea</a>
		</p>
	</article>
}

templ TeapotPage(data TeapotPageData) {
	@BareDocument(data.PageData, TeapotContent(data))
}

templ TeapotContent(data TeapotPageData) {
	if data.IsATeapot {
		<main id="main" class="m-auto mt-16 max-w-5xl p-4"><h1>418 I'm a teapot</h1><p>{ data.BrewMessage.Text }</p></main>
	} else {
		<main id="main" class="m-auto mt-6 max-w-5xl p-4"><p><a href="/" class="opacity-60">@ArrowLeft()
 Home</a></p><h1 class="h1">Here, let's make you a nice cup of :</h1><ul><li><a href="?drink=tea">Tea</a></li><li><a href="?drink=coffee">Coffee</a></li><li><a href={ templ.SafeURL("?drink=" + data.Spewage) }>Random spewage</a></li></ul>
			if data.BrewMessage.Text != "" {
				<hr class="my-4 border-2"/><p class="text-center text-4xl font-black">{ data.BrewMessage.Text }</p><p class="mt-20 text-center">@BigIcon(data.BrewMessage.Emoji)</p>
			}
		</main>
	}
}
