package web

templ KeyPage(data KeyPageData) {
	@Document(data.PageData, KeyContent(data))
}

templ KeyContent(data KeyPageData) {
	<article class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm">
			<a href="/">
				@ArrowLeft()
				home
			</a>
		</p>
		<h1 class="h1">{ data.Heading }</h1>
		<p class="mb-4">{ data.Description }</p>
		for _, key := range data.Keys {
			<section class="mb-8">
				if len(data.Keys) > 1 {
					<h2 class="mb-2 font-bold"><a href={ templ.SafeURL(key.Path) } class="underline">{ key.Heading }</a></h2>
				}
				<pre id={ key.ID } class="mb-4 border-2 p-3 break-all whitespace-pre-wrap">{ key.Key }</pre>
				<p class="actions">
					<button type="button" data-copy-target={ key.ID } onclick="navigator.clipboard.writeText(document.getElementById(this.dataset.copyTarget).textContent.trim()).then(() => { this.textContent = 'copied' })" class="btn">copy</button>
					<a href={ templ.SafeURL(key.RawPath) } class="btn">raw file</a>
				</p>
			</section>
		}
	</article>
}
