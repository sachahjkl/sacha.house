package web

templ LoginForm(data LoginFormData) {
	if data.Error != "" {
		<div class="status-error mb-4" role="alert">❌ { data.Error }</div>
	}
	<form method="POST" action="/admin/login" class="mt-4 mb-6">
		<div class="flex flex-col gap-3">
			<label for="password">Password</label>
			<input type="password" id="password" name="password" placeholder="Password" autocomplete="current-password" required minlength="1" class="h-10 px-3 bg-transparent text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0 border-2 border-textColor"/>
			<button type="submit" formaction="/admin/login" class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800 text-center">🔑 Login with Password</button>
		</div>
	</form>
	<div class="flex flex-col gap-3 mt-4"><button type="button" onclick="loginWebAuthnPasskey(this)" class="h-10 select-none bg-green-700 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#14532d_inset,0_0_0_1px_#15803d_inset,0_0.5px_0_1.5px_#4ade80_inset] hover:bg-green-800 active:bg-green-900 disabled:cursor-wait disabled:opacity-60 text-center">🔐 Login with Passkey</button></div>
	<div id="login-status" class="mt-4 p-3 hidden" role="status" aria-live="polite" aria-atomic="true"></div>
}

templ AdminPasskeyList(passkeys []PasskeyView) {
	<div id="passkey-list">
		<h3 class="mt-6 text-lg font-bold">Registered passkeys</h3>
		if len(passkeys) == 0 {
			<p class="mt-2 opacity-70">No passkeys registered yet.</p>
		} else {
			<ul class="mt-3 space-y-[2px] pl-0 text-base">
				for _, passkey := range passkeys {
					<li class="m-0 flex flex-wrap content-start justify-between gap-2 p-0">
						<div class="min-w-0 flex flex-1 items-center gap-2"><p class="!m-0 wrap-anywhere">{ passkey.Label }</p><code class="min-w-0 flex-1 truncate opacity-50">{ passkey.ID }</code></div>
						<form method="POST" action="/admin/webauthn/remove" class="shrink-0"><button type="submit" name="id" value={ passkey.ID } formaction="/admin/webauthn/remove" title="Unregister" aria-label="Unregister" class="h-8 select-none bg-red-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#991b1b_inset,0_0_0_1px_#dc2626_inset,0_0.5px_0_1.5px_#f87171_inset] hover:bg-red-700 active:bg-red-800">Unregister</button></form>
					</li>
				}
			</ul>
		}
	</div>
}

templ AdminPage(data AdminPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminContent(data))
}

templ AdminContent(data AdminPageData) {
	<article class="prose mx-auto">
		<div class="mb-4 flex flex-wrap items-start justify-between gap-3"><h1 class="h1 !mb-0 flex-1">admin</h1><form method="POST" action="/admin/logout" class="shrink-0"><button type="submit" formaction="/admin/logout" class="h-8 select-none bg-red-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#991b1b_inset,0_0_0_1px_#dc2626_inset,0_0.5px_0_1.5px_#f87171_inset] hover:bg-red-700 active:bg-red-800">👋 Logout</button></form></div>
		if data.Error != "" {
			<div class="status-error mb-4" role="alert">❌ { data.Error }</div>
		}
		<section><h2>📝 Blogposts</h2><p><a href="/admin/blogposts">Manage blogposts -&gt;</a></p></section>
		<section><h2>Encrypted pastes</h2><p><a href="/admin/pastes">Manage encrypted pastes -&gt;</a></p>
			if !data.PasteEnabled {
				<p class="text-sm opacity-70">Disabled: set <code>PASTE_ENABLED</code> and <code>PASTE_SECRETS_FILE</code>.</p>
			}
		</section>
		<section><h2>🔐 WebAuthn Passkeys</h2><p><a href="/admin/webauthn">Manage passkeys -&gt;</a></p></section>
		<section><h2>🕵️ Adresse IP</h2><p>L'IP actuelle avec laquelle tu accèdes au panneau d'admin est <code class="rounded-sm">{ data.IPAddress }</code></p></section>
		<section><h2>📁 Projets</h2><form id="refresh-projects" method="POST" action="/admin/refresh-projects"><button type="submit" formaction="/admin/refresh-projects" class="h-8 select-none bg-blue-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800 active:shadow-[-1px_0px_1px_0px_rgba(0,0,0,.2)_inset,1px_0px_1px_0px_rgba(0,0,0,.2)_inset,0px_0.125rem_0px_0px_rgba(0,0,0,.6)_inset]"><span class="default-text">🚀 Rafraîchir les projets</span></button></form></section>
	</article>
}

templ AdminLoginPage(data AdminLoginPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminLoginContent(data))
}

templ AdminLoginContent(data AdminLoginPageData) {
	<article class="prose mx-auto"><h1 class="h1">admin login</h1><section><h2>🔒 Login Required</h2><p>Enter your admin password or use a passkey:</p><div id="login-form-container">@LoginForm(data.LoginFormData)</div></section></article>
}

templ AdminBlogPostsPage(data AdminBlogPostsPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminBlogPostsContent(data))
}

templ AdminBlogPostsContent(data AdminBlogPostsPageData) {
	<article class="prose mx-auto">
		<p class="mb-4 text-sm"><a href="/admin" class="opacity-60 underline"><span class="inline-block rotate-180">➜</span> Go back to the admin page</a></p>
		<h1 class="h1">manage blogposts</h1><p><a href="/admin/blogposts/new">Create a new blogpost -&gt;</a></p>
		<section><h2>All blogposts</h2><label class="mb-4 flex max-w-xl flex-col gap-1"><span>Filter</span><input id="blogposts-filter" type="text" placeholder="Filter by title, slug, or status" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0"/></label><p id="blogposts-filter-empty" class="mb-4 hidden text-sm opacity-70" role="status">No blogposts match this filter.</p>
			if len(data.Posts) == 0 {
				<p>No blogposts yet.</p>
			}
			<ul id="blogposts-list" class="list-none pl-0">
				for _, post := range data.Posts {
					<li data-blogpost-item class="mb-4 border-2 border-textColor p-3"><p class="!mb-1"><a href={ templ.SafeURL("/admin/blogposts/" + post.Slug) }>{ post.Title }</a></p><p class="!mb-1 text-sm opacity-70"><code>{ post.Slug }</code> / { post.Status } / updated { post.UpdatedAt }</p>
						if post.PublishedAt != "" {
							<p class="!mb-1 text-sm opacity-70">published { post.PublishedAt }</p>
						}
						<p class="!mb-0"><a href={ templ.SafeURL("/admin/blogposts/" + post.Slug) }>edit</a> | <a href={ templ.SafeURL("/blog/" + post.Slug) }>view public page</a></p></li>
				}
			</ul>
		</section>
	</article>
}

templ AdminBlogPostEditorPage(data AdminBlogPostEditorPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminBlogPostEditorContent(data))
}

templ AdminBlogPostEditorContent(data AdminBlogPostEditorPageData) {
	<article class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm"><a href="/admin/blogposts" class="opacity-60 underline"><span class="inline-block rotate-180">➜</span> Go back to the blogposts manager</a></p>
		if data.Form.IsNew {
			<h1 class="h1 mb-4">new blogpost</h1>
		} else {
			<h1 class="h1 mb-4">edit blogpost</h1>
		}
		if data.Error != "" {
			<div class="mb-4 border-2 border-red-500 bg-red-100 p-3 text-red-800" role="alert">{ data.Error }</div>
		}
		<div id="blog-editor-status" class="mb-4 hidden border-2 border-blue-300 bg-blue-100 p-3 text-blue-800" role="status" aria-live="polite" aria-atomic="true"></div>
		<form method="POST" action={ templ.SafeURL(data.Form.FormAction) } data-blog-editor class="flex flex-col gap-4">
			<div class="grid gap-4 md:grid-cols-2">
				<label class="flex flex-col gap-1"><span>Title</span><input id="blog-title" type="text" name="title" value={ data.Form.Title } required class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0"/></label>
				<label class="flex flex-col gap-1"><span>Slug</span><input id="blog-slug" type="text" name="slug" value={ data.Form.Slug } required class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0"/></label>
				<label class="flex flex-col gap-1"><span>Status</span><select name="status" class="h-10 border-2 border-textColor bg-bgColor px-3 text-textColor focus:outline-none focus:ring-0">
					if data.Form.Status == "published" {
						<option value="draft" class="bg-bgColor text-textColor">draft</option><option value="published" class="bg-bgColor text-textColor" selected>published</option>
					} else {
						<option value="draft" class="bg-bgColor text-textColor" selected>draft</option><option value="published" class="bg-bgColor text-textColor">published</option>
					}
				</select></label>
				<label class="flex flex-col gap-1"><span>Language</span><select name="language" class="h-10 border-2 border-textColor bg-bgColor px-3 text-textColor focus:outline-none focus:ring-0">
					if data.Form.Language == "fr" {
						<option value="en" class="bg-bgColor text-textColor">English</option><option value="fr" class="bg-bgColor text-textColor" selected>Français</option>
					} else {
						<option value="en" class="bg-bgColor text-textColor" selected>English</option><option value="fr" class="bg-bgColor text-textColor">Français</option>
					}
				</select></label>
				<label class="flex flex-col gap-1"><span>Published At</span><div class="flex gap-2"><input id="blog-published-at" type="datetime-local" name="publishedAt" value={ data.Form.PublishedAt } class="h-10 min-w-0 flex-1 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0"/><button type="button" id="blog-published-at-picker" class="h-10 border-2 border-textColor px-3 leading-8">pick</button></div></label>
			</div>
			<div><p class="mb-2 text-sm opacity-70">Paste an image directly into the markdown textarea with Ctrl+V and it will upload automatically. Set the slug first so the image is stored under the correct post.</p><label class="flex flex-col gap-1"><span>Markdown</span><textarea id="blog-markdown" name="markdown" rows="24" class="min-h-[32rem] border-2 border-textColor bg-transparent p-3 font-mono text-sm text-textColor placeholder-neutral-400 focus:outline-none focus:ring-0">{ data.Form.Markdown }</textarea></label></div>
			<div class="flex flex-wrap gap-3"><button type="submit" formaction={ templ.SafeURL(data.Form.FormAction) } class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800 text-center">Save blogpost</button>
				if data.Form.PublicURL != "" {
					<a href={ templ.SafeURL(data.Form.PublicURL) } class="inline-block h-10 border-2 border-textColor px-4 leading-10">Open public page</a>
				}
			</div>
			if data.Form.CreatedAt != "" || data.Form.UpdatedAt != "" {
				<p class="text-sm opacity-70">
					if data.Form.CreatedAt != "" {
						{ "created " + data.Form.CreatedAt }
					}
					if data.Form.CreatedAt != "" && data.Form.UpdatedAt != "" {
						/
					}
					if data.Form.UpdatedAt != "" {
						{ "updated " + data.Form.UpdatedAt }
					}
				</p>
			}
		</form>
		<section><h2 class="mb-4 text-2xl font-bold">Preview</h2><article class="prose max-w-none">@templ.Raw(data.PreviewHTML)</article></section>
	</article>
}

templ AdminWebAuthnPage(data AdminWebAuthnPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminWebAuthnContent(data))
}

templ AdminWebAuthnContent(data AdminWebAuthnPageData) {
	<article class="prose mx-auto">
		<p class="mb-4 text-sm"><a href="/admin" class="opacity-60 underline"><span class="inline-block rotate-180">➜</span> Go back to the admin page</a></p><h1 class="h1">manage passkeys</h1>
		if data.Error != "" {
			<div class="status-error mb-4" role="alert">❌ { data.Error }</div>
		}
		<section><h2>🔐 WebAuthn Passkeys</h2><div class="mb-4"><p>Register, label, test, and remove WebAuthn passkeys for this admin panel.</p><label for="passkey-label" class="mt-4 block text-sm font-bold">Passkey label</label><input id="passkey-label" name="label" type="text" maxlength="80" placeholder="YubiKey 5 NFC" class="mt-2 block w-full max-w-md border border-current bg-transparent px-3 py-2"/>
			<div class="mt-4 flex flex-wrap gap-2"><button type="button" onclick="registerPasskey(this)" class="h-8 select-none bg-green-700 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#14532d_inset,0_0_0_1px_#15803d_inset,0_0.5px_0_1.5px_#4ade80_inset] hover:bg-green-800 active:bg-green-900 disabled:cursor-wait disabled:opacity-60">🔑 Register New Passkey</button><button type="button" onclick="testPasskey(this)" class="h-8 select-none bg-blue-600 px-3 text-sm leading-8 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800 disabled:cursor-wait disabled:opacity-60">🧪 Test Passkey</button></div><div id="passkey-status" class="mt-4 hidden p-3" role="status" aria-live="polite" aria-atomic="true"></div>
			@AdminPasskeyList(data.Passkeys)
			<button id="refresh-passkeys" type="button" hidden data-on:click="@get('/admin/webauthn/passkeys')">Refresh passkeys</button>
		</div></section>
	</article>
}

templ AdminPastesPage(data AdminPastesPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminPastesContent(data))
}

templ AdminPastesContent(data AdminPastesPageData) {
	<article class="prose mx-auto">
		<p class="mb-4 text-sm"><a href="/admin" class="opacity-60 underline"><span class="inline-block rotate-180" aria-hidden="true">➜</span> Go back to the admin page</a></p>
		<h1 class="h1">encrypted pastes</h1>
		if data.Error != "" {
			<div class="mb-4 border-2 border-red-500 bg-red-100 p-3 text-red-800" role="alert" aria-live="assertive">{ data.Error }</div>
		}
		if data.Notice != "" {
			<div class="mb-4 border-2 border-blue-300 bg-blue-100 p-3 text-blue-800" role="status" aria-live="polite">{ data.Notice }</div>
		}
		if data.Truncated {
			<p class="mb-4 border-2 border-textColor p-3" role="status">This list is incomplete. Refresh after the storage limit or rate limit clears.</p>
		}
		<p><a href="/admin/pastes/new">Create an encrypted paste -&gt;</a></p>
		<section aria-labelledby="paste-list-heading"><h2 id="paste-list-heading">Owned encrypted Gists</h2>
			if len(data.Items) == 0 {
				<p>No encrypted pastes are available.</p>
			}
			<ul class="list-none pl-0">
				for _, item := range data.Items {
					<li class="mb-4 border-2 border-textColor p-3">
						<p class="!mb-1 font-bold">
							if item.Title != "" {
								{ item.Title }
							} else {
								<span class="opacity-70">Plaintext unavailable</span>
							}
						</p>
						<dl class="!my-2 text-sm"><dt class="font-bold">Status</dt><dd class="!ml-0">{ item.Status }</dd><dt class="font-bold">Gist ID</dt><dd class="!ml-0 wrap-anywhere"><code>{ item.GistID }</code></dd><dt class="font-bold">Paste ID</dt><dd class="!ml-0 wrap-anywhere"><code>{ item.PasteID }</code></dd><dt class="font-bold">Revision</dt><dd class="!ml-0 wrap-anywhere"><code>{ item.Revision }</code></dd><dt class="font-bold">Key</dt><dd class="!ml-0 wrap-anywhere"><code>{ item.KeyID }</code></dd><dt class="font-bold">Provider timestamps</dt><dd class="!ml-0">created { item.CreatedAt } / updated { item.UpdatedAt }</dd></dl>
						if item.CanEdit {
							<div class="flex flex-wrap gap-3"><a href={ templ.SafeURL("/admin/pastes/" + item.GistID) } class="inline-block h-10 border-2 border-textColor px-4 leading-10">Edit</a><form method="POST" action={ templ.SafeURL("/admin/pastes/" + item.GistID + "/rotate") }><button type="submit" name="revision" value={ item.Revision } formaction={ templ.SafeURL("/admin/pastes/" + item.GistID + "/rotate") } class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">
								if item.NeedsRotation {
									Rotate to active key
								} else {
									Re-encrypt
								}
							</button></form></div>
						}
					</li>
				}
			</ul>
		</section>
	</article>
}

templ AdminPasteEditorPage(data AdminPasteEditorPageData, navigation Navigation) {
	@Document(data.PageData, navigation, AdminPasteEditorContent(data))
}

templ AdminPasteEditorContent(data AdminPasteEditorPageData) {
	<article class="mx-auto max-w-5xl">
		<p class="mb-4 text-sm"><a href="/admin/pastes" class="opacity-60 underline"><span class="inline-block rotate-180" aria-hidden="true">➜</span> Go back to encrypted pastes</a></p>
		if data.Form.IsNew {
			<h1 class="h1 mb-4">new encrypted paste</h1>
		} else {
			<h1 class="h1 mb-4">edit encrypted paste</h1>
		}
		if data.Error != "" {
			<div class="mb-4 border-2 border-red-500 bg-red-100 p-3 text-red-800" role="alert" aria-live="assertive">{ data.Error }</div>
		}
		if data.Notice != "" {
			<div class="mb-4 border-2 border-blue-300 bg-blue-100 p-3 text-blue-800" role="status" aria-live="polite">{ data.Notice }</div>
		}
		if data.Form.NeedsRotation {
			<p class="mb-4 border-2 border-textColor p-3" role="status">This paste uses an older key. Saving or rotating will re-encrypt it with the active key.</p>
		}
		if data.Form.GistID != "" {
			<dl class="mb-4 text-sm"><dt class="font-bold">Gist ID</dt><dd class="ml-0 wrap-anywhere"><code>{ data.Form.GistID }</code></dd><dt class="font-bold">Revision</dt><dd class="ml-0 wrap-anywhere"><code>{ data.Form.Revision }</code></dd><dt class="font-bold">Encryption key</dt><dd class="ml-0 wrap-anywhere"><code>{ data.Form.KeyID }</code></dd></dl>
		}
		<form method="POST" action={ templ.SafeURL(data.Form.FormAction) } class="flex flex-col gap-4">
			<label class="flex flex-col gap-1" for="paste-title"><span>Title</span><input id="paste-title" type="text" name="title" value={ data.Form.Title } maxlength="200" required autocomplete="off" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor placeholder-neutral-400"/></label>
			<label class="flex flex-col gap-1" for="paste-body"><span>Paste body</span><textarea id="paste-body" name="body" rows="24" spellcheck="false" class="min-h-[32rem] border-2 border-textColor bg-transparent p-3 font-mono text-sm text-textColor placeholder-neutral-400">{ data.Form.Body }</textarea></label>
			if data.Form.IsNew {
				<div class="flex flex-wrap gap-3"><button type="submit" formaction={ templ.SafeURL(data.Form.FormAction) } class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">Save encrypted paste</button></div>
			} else {
				<div class="flex flex-wrap gap-3"><button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL(data.Form.FormAction) } class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800">Save encrypted paste</button></div>
			}
		</form>
		if !data.Form.IsNew && data.Form.Revision != "" {
			<section class="mt-8 space-y-3 border-t-2 border-textColor pt-6" aria-labelledby="paste-rotation-heading"><h2 id="paste-rotation-heading" class="text-xl font-bold">Encryption rotation</h2><p>Re-encrypt the current plaintext with the active key without changing its semantic timestamps.</p><form method="POST" action={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/rotate") } class="pt-1"><button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/rotate") } class="h-10 select-none bg-blue-600 px-4 text-base leading-10 text-zinc-50 shadow-[0_-1px_0_1px_#1e3a8a_inset,0_0_0_1px_#1d4ed8_inset,0_0.5px_0_1.5px_#60a5fa_inset] hover:bg-blue-700 active:bg-blue-800 active:shadow-[-1px_0px_1px_0px_rgba(0,0,0,.2)_inset,1px_0px_1px_0px_rgba(0,0,0,.2)_inset,0px_0.125rem_0px_0px_rgba(0,0,0,.6)_inset]">Re-encrypt with active key</button></form></section>
			<section class="mt-8 space-y-3 border-t-2 border-red-600 pt-6" aria-labelledby="paste-delete-heading"><h2 id="paste-delete-heading" class="text-xl font-bold text-red-500">Delete encrypted paste</h2><p>This permanently deletes the Gist. Provider revision history may remain subject to GitHub's retention policy.</p><form method="POST" action={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/delete") } class="flex flex-col gap-4 pt-1" data-no-boost><label class="flex max-w-md flex-col gap-2" for="paste-delete-confirmation"><span>Type DELETE to confirm</span><input id="paste-delete-confirmation" type="text" name="confirmation" required pattern="DELETE" autocomplete="off" class="h-10 border-2 border-textColor bg-transparent px-3 text-textColor"/></label><div><button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/delete") } class="h-10 select-none border-2 border-red-600 bg-transparent px-4 text-base leading-9 text-red-500 hover:bg-red-600 hover:text-white">Delete encrypted paste</button></div></form></section>
		}
	</article>
}
