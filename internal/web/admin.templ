package web

import "fmt"

// AdminBack is the link back to the parent admin page.
templ AdminBack(href string, label string) {
	<p class="back-link">
		<a href={ templ.SafeURL(href) }>
			@ArrowLeft()
			{ label }
		</a>
	</p>
}

// AdminMessages shows the outcome of the last action.
templ AdminMessages(failure string, notice string) {
	if failure != "" {
		<div class="status status-error mb-4" role="alert" aria-live="assertive">{ failure }</div>
	}
	if notice != "" {
		<div class="status mb-4" role="status" aria-live="polite">{ notice }</div>
	}
}

templ LoginForm(data LoginFormData) {
	@AdminMessages(data.Error, "")
	<form method="POST" action="/admin/login" class="form">
		<label class="field" for="password">
			<span>Password</span>
			<input class="input" type="password" id="password" name="password" autocomplete="current-password" required minlength="1"/>
		</label>
		<button type="submit" formaction="/admin/login" class="btn btn-primary">Log in with password</button>
	</form>
	<p class="form-or meta">or</p>
	<button type="button" onclick="loginWebAuthnPasskey(this)" class="btn btn-block">Log in with a passkey</button>
	<div id="login-status" class="mt-4 hidden" role="status" aria-live="polite" aria-atomic="true"></div>
}

templ AdminPasskeyList(passkeys []PasskeyView) {
	<div id="passkey-list">
		if len(passkeys) == 0 {
			<p class="meta">No passkeys registered yet.</p>
		} else {
			<ul class="rows">
				for _, passkey := range passkeys {
					<li>
						<div class="row">
							<div class="row-main">
								<p class="row-title">{ passkey.Label }</p>
								<p class="meta row-code"><code>{ passkey.ID }</code></p>
							</div>
							<form method="POST" action="/admin/webauthn/remove"><button type="submit" name="id" value={ passkey.ID } formaction="/admin/webauthn/remove" class="btn btn-danger">Unregister</button></form>
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

templ AdminPage(data AdminPageData) {
	@Document(data.PageData, AdminContent(data))
}

// ProjectRefreshStatus shows a step of the refresh. kind is empty, status-ok, or status-error.
templ ProjectRefreshStatus(message string, kind string) {
	<p id="project-refresh-status" class={ "status mt-3", kind } role="status" aria-live="polite">{ message }</p>
}

templ AdminContent(data AdminPageData) {
	<article>
		<div class="admin-head">
			<h1 class="h1">admin</h1>
			<form method="POST" action="/admin/logout"><button type="submit" formaction="/admin/logout" class="btn">Log out</button></form>
		</div>
		@AdminMessages(data.Error, "")
		<div class="panes">
			<section class="pane">
				<h2 class="pane-title">blog</h2>
				<p>Write, edit, and publish posts.</p>
				if data.BlogConflicts > 0 {
					<p class="status status-error">{ fmt.Sprint(data.BlogConflicts) } blogposts changed both in the repository and here: resolve them in the list.</p>
				}
				<p class="actions"><a class="btn" href="/admin/blogposts">Manage blogposts</a><a class="btn" href="/admin/blogposts/new">New blogpost</a></p>
			</section>
			<section class="pane">
				<h2 class="pane-title">pastes</h2>
				<p>Encrypted notes stored in GitHub Gists.</p>
				if data.PasteEnabled {
					<p class="actions"><a class="btn" href="/admin/pastes">Manage encrypted pastes</a></p>
				} else {
					<p class="meta">Disabled: set <code>PASTE_ENABLED</code> and <code>PASTE_SECRETS_FILE</code>.</p>
				}
			</section>
			<section class="pane">
				<h2 class="pane-title">passkeys</h2>
				<p>Register, test, and remove the WebAuthn passkeys of this panel.</p>
				<p class="actions"><a class="btn" href="/admin/webauthn">Manage passkeys</a></p>
			</section>
			<section class="pane">
				<h2 class="pane-title">projects</h2>
				<p>Fetch the repositories of the projects page from GitHub.</p>
				<form id="refresh-projects" class="actions" method="POST" action="/admin/refresh-projects" data-on:submit__prevent="@post('/admin/refresh-projects')" data-indicator:refreshing>
					<button type="submit" formaction="/admin/refresh-projects" data-attr:disabled="$refreshing" class="btn"><span data-show="!$refreshing">Refresh projects</span><span data-show="$refreshing" style="display:none">Refreshing…</span></button>
				</form>
				<p id="project-refresh-status" class="hidden" role="status" aria-live="polite"></p>
			</section>
		</div>
		<p class="meta mt-6">Connected from <code>{ data.IPAddress }</code></p>
	</article>
}

templ AdminLoginPage(data AdminLoginPageData) {
	@Document(data.PageData, AdminLoginContent(data))
}

templ AdminLoginContent(data AdminLoginPageData) {
	<article class="admin-narrow">
		<h1 class="h1">admin login</h1>
		<div id="login-form-container">
			@LoginForm(data.LoginFormData)
		</div>
	</article>
}

templ AdminBlogPostsPage(data AdminBlogPostsPageData) {
	@Document(data.PageData, AdminBlogPostsContent(data))
}

templ AdminBlogPostsContent(data AdminBlogPostsPageData) {
	<article>
		@AdminBack("/admin", "admin")
		<div class="admin-head">
			<h1 class="h1">blogposts</h1>
			<a class="btn btn-primary" href="/admin/blogposts/new">New blogpost</a>
		</div>
		<label class="field mb-6">
			<span>Filter</span>
			<input class="input" id="blogposts-filter" type="text" placeholder="Title, slug, or status"/>
		</label>
		<p id="blogposts-filter-empty" class="meta mb-4 hidden" role="status">No blogposts match this filter.</p>
		if len(data.Posts) == 0 {
			<p>No blogposts yet.</p>
		}
		<ul id="blogposts-list" class="rows">
			for _, post := range data.Posts {
				<li data-blogpost-item>
					<div class="row">
						<div class="row-main">
							<p class="row-title"><a href={ templ.SafeURL("/admin/blogposts/" + post.Slug) }>{ post.Title }</a></p>
							<p class="meta row-code">
								<code>{ post.Slug }</code> · { post.Status } · updated { post.UpdatedAt }
								if post.PublishedAt != "" {
									· published { post.PublishedAt }
								}
								if post.Conflict {
									· <strong class="conflict-badge">conflict</strong>
								}
							</p>
						</div>
						if post.Conflict {
							<a class="btn btn-primary" href={ templ.SafeURL("/admin/blogposts/" + post.Slug + "/conflict") }>Resolve</a>
						}
						<a class="btn" href={ templ.SafeURL("/blog/" + post.Slug) }>View</a>
					</div>
				</li>
			}
		</ul>
	</article>
}

templ AdminBlogPostEditorPage(data AdminBlogPostEditorPageData) {
	@Document(data.PageData, AdminBlogPostEditorContent(data))
}

templ AdminBlogPostEditorContent(data AdminBlogPostEditorPageData) {
	<article>
		@AdminBack("/admin/blogposts", "blogposts")
		if data.Form.IsNew {
			<h1 class="h1">new blogpost</h1>
		} else {
			<h1 class="h1">edit blogpost</h1>
		}
		@AdminMessages(data.Error, "")
		<div id="blog-editor-status" class="mb-4 hidden" role="status" aria-live="polite" aria-atomic="true"></div>
		<form method="POST" action={ templ.SafeURL(data.Form.FormAction) } data-blog-editor data-current-slug={ data.Form.CurrentSlug } data-session-guard="blog-editor-status" class="form">
			if data.Form.Revision != "" {
				<input type="hidden" name="revision" value={ data.Form.Revision }/>
			}
			<div class="form-grid">
				<label class="field"><span>Title</span><input class="input" id="blog-title" type="text" name="title" value={ data.Form.Title } required/></label>
				<label class="field"><span>Slug</span><input class="input" id="blog-slug" type="text" name="slug" value={ data.Form.Slug } required/></label>
				<label class="field"><span>Description</span><input class="input" id="blog-description" type="text" name="description" value={ data.Form.Description } maxlength="300" placeholder="One sentence for search results and link previews"/></label>
				<label class="field">
					<span>Status</span>
					<select class="input" name="status">
						if data.Form.Status == "published" {
							<option value="draft">draft</option>
							<option value="published" selected>published</option>
						} else {
							<option value="draft" selected>draft</option>
							<option value="published">published</option>
						}
					</select>
				</label>
				<label class="field">
					<span>Language</span>
					<select class="input" name="language">
						if data.Form.Language == "fr" {
							<option value="en">English</option>
							<option value="fr" selected>Français</option>
						} else {
							<option value="en" selected>English</option>
							<option value="fr">Français</option>
						}
					</select>
				</label>
				<label class="field">
					<span>Published at</span>
					<span class="field-row">
						<input class="input" id="blog-published-at" type="datetime-local" name="publishedAt" value={ data.Form.PublishedAt }/>
						<button type="button" id="blog-published-at-picker" class="btn">pick</button>
					</span>
				</label>
			</div>
			<label class="field">
				<span>Markdown</span>
				<textarea class="input input-editor" id="blog-markdown" name="markdown" rows="24">{ data.Form.Markdown }</textarea>
				<span class="meta">Paste an image with Ctrl+V to upload it. Set the slug first so the image is stored under the correct post.</span>
			</label>
			<div class="form-actions">
				<button type="submit" formaction={ templ.SafeURL(data.Form.FormAction) } class="btn btn-primary">Save blogpost</button>
				if data.Form.PublicURL != "" {
					<a href={ templ.SafeURL(data.Form.PublicURL) } class="btn">Open public page</a>
				}
				if data.Form.CreatedAt != "" || data.Form.UpdatedAt != "" {
					<p class="meta">
						if data.Form.CreatedAt != "" {
							{ "created " + data.Form.CreatedAt }
						}
						if data.Form.CreatedAt != "" && data.Form.UpdatedAt != "" {
							·
						}
						if data.Form.UpdatedAt != "" {
							{ "updated " + data.Form.UpdatedAt }
						}
					</p>
				}
			</div>
		</form>
		<section class="pane pane-wide">
			<h2 class="pane-title">preview</h2>
			<article class="prose">
				@templ.Raw(data.PreviewHTML)
			</article>
		</section>
	</article>
}

templ AdminWebAuthnPage(data AdminWebAuthnPageData) {
	@Document(data.PageData, AdminWebAuthnContent(data))
}

templ AdminWebAuthnContent(data AdminWebAuthnPageData) {
	<article>
		@AdminBack("/admin", "admin")
		<h1 class="h1">passkeys</h1>
		@AdminMessages(data.Error, "")
		<section class="mb-8">
			<label class="field" for="passkey-label">
				<span>Passkey label</span>
				<input class="input" id="passkey-label" name="label" type="text" maxlength="80" placeholder="YubiKey 5 NFC"/>
			</label>
			<p class="actions">
				<button type="button" onclick="registerPasskey(this)" class="btn btn-primary">Register new passkey</button>
				<button type="button" onclick="testPasskey(this)" class="btn">Test a passkey</button>
			</p>
			<div id="passkey-status" class="mt-4 hidden" role="status" aria-live="polite" aria-atomic="true"></div>
		</section>
		<section>
			<h2 class="h2">registered passkeys</h2>
			@AdminPasskeyList(data.Passkeys)
			<button id="refresh-passkeys" type="button" hidden data-on:click="@get('/admin/webauthn/passkeys')">Refresh passkeys</button>
		</section>
	</article>
}

templ AdminPastesPage(data AdminPastesPageData) {
	@Document(data.PageData, AdminPastesContent(data))
}

templ AdminPastesContent(data AdminPastesPageData) {
	<article>
		@AdminBack("/admin", "admin")
		<div class="admin-head">
			<h1 class="h1">encrypted pastes</h1>
			<a class="btn btn-primary" href="/admin/pastes/new">New paste</a>
		</div>
		@AdminMessages(data.Error, data.Notice)
		if data.Truncated {
			<p class="status mb-4" role="status">This list is incomplete. Refresh after the storage limit or rate limit clears.</p>
		}
		<section aria-labelledby="paste-list-heading">
			<h2 id="paste-list-heading" class="h2">owned encrypted gists</h2>
			if len(data.Items) == 0 {
				<p>No encrypted pastes are available.</p>
			}
			<ul class="rows">
				for _, item := range data.Items {
					<li>
						<p class="row-title">
							if item.Title != "" {
								{ item.Title }
							} else {
								<span class="meta">Plaintext unavailable</span>
							}
						</p>
						<dl class="facts facts-wide my-2 text-sm">
							<dt>status</dt>
							<dd>{ item.Status }</dd>
							<dt>gist</dt>
							<dd><code>{ item.GistID }</code></dd>
							<dt>paste</dt>
							<dd><code>{ item.PasteID }</code></dd>
							<dt>revision</dt>
							<dd><code>{ item.Revision }</code></dd>
							<dt>key</dt>
							<dd><code>{ item.KeyID }</code></dd>
							<dt>timestamps</dt>
							<dd>created { item.CreatedAt } · updated { item.UpdatedAt }</dd>
						</dl>
						if item.CanEdit {
							<div class="form-actions">
								<a href={ templ.SafeURL("/admin/pastes/" + item.GistID) } class="btn">Edit</a>
								<form method="POST" action={ templ.SafeURL("/admin/pastes/" + item.GistID + "/rotate") }>
									<button type="submit" name="revision" value={ item.Revision } formaction={ templ.SafeURL("/admin/pastes/" + item.GistID + "/rotate") } class="btn">
										if item.NeedsRotation {
											Rotate to active key
										} else {
											Re-encrypt
										}
									</button>
								</form>
							</div>
						} else if item.Revision != "" {
							<form method="POST" action={ templ.SafeURL("/admin/pastes/" + item.GistID + "/delete") } class="form-actions" data-no-boost>
								<label class="field">
									<span class="meta">This paste cannot be read. Type DELETE to remove it.</span>
									<input class="input" type="text" name="confirmation" required pattern="DELETE" autocomplete="off" aria-label="Type DELETE to confirm"/>
								</label>
								<button type="submit" name="revision" value={ item.Revision } formaction={ templ.SafeURL("/admin/pastes/" + item.GistID + "/delete") } class="btn btn-danger">Delete</button>
							</form>
						}
					</li>
				}
			</ul>
		</section>
	</article>
}

templ AdminPasteEditorPage(data AdminPasteEditorPageData) {
	@Document(data.PageData, AdminPasteEditorContent(data))
}

templ AdminPasteEditorContent(data AdminPasteEditorPageData) {
	<article>
		@AdminBack("/admin/pastes", "encrypted pastes")
		if data.Form.IsNew {
			<h1 class="h1">new encrypted paste</h1>
		} else {
			<h1 class="h1">edit encrypted paste</h1>
		}
		@AdminMessages(data.Error, data.Notice)
		if data.Form.NeedsRotation {
			<p class="status mb-4" role="status">This paste uses an older key. Saving or rotating will re-encrypt it with the active key.</p>
		}
		if data.Form.GistID != "" {
			<dl class="facts facts-wide mb-4 text-sm">
				<dt>gist</dt>
				<dd><code>{ data.Form.GistID }</code></dd>
				<dt>revision</dt>
				<dd><code>{ data.Form.Revision }</code></dd>
				<dt>key</dt>
				<dd><code>{ data.Form.KeyID }</code></dd>
			</dl>
		}
		<div id="paste-editor-status" class="mb-4 hidden" role="status" aria-live="polite" aria-atomic="true"></div>
		<form method="POST" action={ templ.SafeURL(data.Form.FormAction) } data-session-guard="paste-editor-status" class="form">
			<label class="field" for="paste-title"><span>Title</span><input class="input" id="paste-title" type="text" name="title" value={ data.Form.Title } maxlength="200" required autocomplete="off"/></label>
			<label class="field" for="paste-body"><span>Paste body</span><textarea class="input input-editor" id="paste-body" name="body" rows="24" spellcheck="false">{ data.Form.Body }</textarea></label>
			<div class="form-actions">
				if data.Form.IsNew {
					<button type="submit" formaction={ templ.SafeURL(data.Form.FormAction) } class="btn btn-primary">Save encrypted paste</button>
				} else {
					<button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL(data.Form.FormAction) } class="btn btn-primary">Save encrypted paste</button>
				}
			</div>
		</form>
		if !data.Form.IsNew && data.Form.Revision != "" {
			<section class="pane pane-wide" aria-labelledby="paste-rotation-heading">
				<h2 id="paste-rotation-heading" class="pane-title">encryption rotation</h2>
				<p>Re-encrypt the current plaintext with the active key without changing its semantic timestamps.</p>
				<form method="POST" action={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/rotate") } class="actions">
					<button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/rotate") } class="btn">Re-encrypt with active key</button>
				</form>
			</section>
			<section class="pane pane-wide pane-danger" aria-labelledby="paste-delete-heading">
				<h2 id="paste-delete-heading" class="pane-title">delete encrypted paste</h2>
				<p>This permanently deletes the Gist. Provider revision history may remain subject to GitHub's retention policy.</p>
				<form method="POST" action={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/delete") } class="form mt-4" data-no-boost>
					<label class="field" for="paste-delete-confirmation">
						<span>Type DELETE to confirm</span>
						<input class="input" id="paste-delete-confirmation" type="text" name="confirmation" required pattern="DELETE" autocomplete="off"/>
					</label>
					<div class="form-actions"><button type="submit" name="revision" value={ data.Form.Revision } formaction={ templ.SafeURL("/admin/pastes/" + data.Form.GistID + "/delete") } class="btn btn-danger">Delete encrypted paste</button></div>
				</form>
			</section>
		}
	</article>
}

templ AdminBlogConflictPage(data AdminBlogConflictPageData) {
	@Document(data.PageData, AdminBlogConflictContent(data))
}

// AdminBlogConflictContent compares the site and repository versions of a post and offers the resolutions.
templ AdminBlogConflictContent(data AdminBlogConflictPageData) {
	<article>
		@AdminBack("/admin/blogposts", "blogposts")
		<h1 class="h1">conflict: { data.Title }</h1>
		@AdminMessages(data.Error, "")
		<p class="mb-4">This post changed in the repository and in this admin since the last merge. The site shows the admin version until you choose.</p>
		<section class="mb-6">
			<h2 class="pane-title">metadata</h2>
			<table class="conflict-fields">
				<thead><tr><th scope="col">field</th><th scope="col">site</th><th scope="col">repository</th></tr></thead>
				<tbody>
					for _, field := range data.Fields {
						<tr class={ templ.KV("conflict-differs", field.Differs()) }>
							<th scope="row">{ field.Name }</th>
							<td>{ field.Site }</td>
							<td>{ field.Repository }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
		<section class="mb-6">
			<h2 class="pane-title">text</h2>
			if len(data.Content) == 0 {
				<p class="meta">The text is the same in both versions.</p>
			} else {
				<p class="meta mb-2"><span class="diff-remove">− site only</span> · <span class="diff-add">+ repository only</span></p>
				<div class="diff">
					for _, hunk := range data.Content {
						if hunk.Skipped > 0 {
							<div class="diff-skip">{ fmt.Sprintf("… %d unchanged lines", hunk.Skipped) }</div>
						}
						for _, line := range hunk.Lines {
							<div class={ "diff-line", "diff-" + line.Kind }><span class="diff-sign" aria-hidden="true">{ diffSign(line.Kind) }</span>{ line.Text }</div>
						}
					}
				</div>
			}
		</section>
		<div class="actions">
			<form method="POST" action={ templ.SafeURL("/admin/blogposts/" + data.Slug + "/conflict/take-repository") }>
				<button type="submit" class="btn btn-primary">Take the repository version</button>
			</form>
			<form method="POST" action={ templ.SafeURL("/admin/blogposts/" + data.Slug + "/conflict/keep-site") }>
				<button type="submit" class="btn">Keep the site version</button>
			</form>
			<a class="btn" href={ templ.SafeURL("/admin/blogposts/" + data.Slug) }>Edit the site version</a>
		</div>
		<p class="meta mt-4">Taking the repository version keeps the uploaded images. Keeping the site version stops this report until the repository changes again; copy the site version into the repository to end the conflicts for good.</p>
	</article>
}
